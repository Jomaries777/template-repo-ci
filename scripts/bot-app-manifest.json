{
  "manifest": {
    "name": "<name>",
    "url": "https://github.com/Jomaries777/template-repo-ci",
    "description": "Bot identity for <agent-label> in repos created from template-repo-ci. Never approves its own PRs; only the owner approves.",
    "public": false,
    "hook_attributes": {
      "url": "https://example.invalid/unused",
      "active": false
    },
    "redirect_url": "https://github.com/Jomaries777/template-repo-ci",
    "default_permissions": "<permissions>",
    "default_events": []
  },
  "labels": {
    "claude": "Claude Code and Claude in CI",
    "agy": "Antigravity",
    "ci": "non-AI automation (Dependabot merges)"
  },
  "permissions": {
    "agent": {
      "contents": "write",
      "pull_requests": "write",
      "issues": "write",
      "checks": "write",
      "actions": "read",
      "metadata": "read"
    },
    "ci": {
      "contents": "write",
      "pull_requests": "write",
      "metadata": "read"
    }
  }
}
