#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=deploy/targets/github-pages/lib.sh disable=SC1091
source "$(cd "$(dirname "$0")" && pwd)/lib.sh"
# preview <env> <sha>: serve the static export of <sha> on localhost and
# print its URL, for the pre-traffic test (C9). `discard` stops it.
init_common
env_check "${1:-}"
sha_check "${2:-}"
dir="$(export_for "$2")"
if [[ "$DRY_RUN" == "1" ]]; then
  run python3 -m http.server --bind 127.0.0.1 --directory "$dir" 8000
  printf "%s\n" "http://127.0.0.1:8000/"
  exit 0
fi
port="$(python3 -c "import socket; s=socket.socket(); s.bind((\"127.0.0.1\", 0)); print(s.getsockname()[1]); s.close()")"
nohup python3 -m http.server --bind 127.0.0.1 --directory "$dir" "$port" >"$STATE/preview.log" 2>&1 &
echo $! >"$STATE/preview.pid"
for _ in $(seq 1 50); do
  if curl -fsS -o /dev/null "http://127.0.0.1:$port/"; then
    printf "%s\n" "http://127.0.0.1:$port/"
    exit 0
  fi
  sleep 0.2
done
die "the local preview did not start (see $STATE/preview.log)"
