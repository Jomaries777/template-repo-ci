#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=deploy/targets/github-pages/lib.sh disable=SC1091
source "$(cd "$(dirname "$0")" && pwd)/lib.sh"
# bootstrap: one-time, idempotent setup, run by the owner with their gh login.
# Creates an empty gh-pages branch (through the API, no clone) and turns on
# Pages for it. Nothing to bill: Pages is free on public repositories.
init_common

if [[ "$DRY_RUN" != "1" ]]; then
  gh auth status >/dev/null 2>&1 || die "gh is not logged in (run: gh auth login)"
fi

echo "== gh-pages branch" >&2
if [[ "$DRY_RUN" != "1" ]] && gh api "repos/$REPO/branches/$BRANCH" --silent 2>/dev/null; then
  echo "    $BRANCH already exists" >&2
else
  # A root commit holding only .nojekyll (Pages serves files as they are).
  tree="$(query "2222222222222222222222222222222222222222" gh api -X POST "repos/$REPO/git/trees" --jq .sha \
    --input - <<<'{"tree":[{"path":".nojekyll","mode":"100644","type":"blob","content":""}]}')"
  commit="$(query "3333333333333333333333333333333333333333" gh api -X POST "repos/$REPO/git/commits" \
    -f message="Create gh-pages for GitHub Pages" -f tree="$tree" --jq .sha)"
  run gh api -X POST "repos/$REPO/git/refs" -f ref="refs/heads/$BRANCH" -f sha="$commit" --silent
fi

echo "== Pages" >&2
pages_args=(-f build_type=legacy -f "source[branch]=$BRANCH" -f 'source[path]=/' --silent)
set_source() { run gh api -X PUT "repos/$REPO/pages" "${pages_args[@]}"; }
if [[ "$DRY_RUN" != "1" ]] && gh api "repos/$REPO/pages" --silent 2>/dev/null; then
  echo "    Pages already enabled" >&2
  set_source
elif [[ "$DRY_RUN" == "1" ]]; then
  run gh api -X POST "repos/$REPO/pages" "${pages_args[@]}"
else
  # Creating gh-pages makes GitHub turn Pages on by itself a moment later, so
  # the check above can miss it and the POST answer 409: set the source then.
  if ! post_err="$(gh api -X POST "repos/$REPO/pages" "${pages_args[@]}" 2>&1 >/dev/null)"; then
    grep -q 'HTTP 409' <<<"$post_err" || die "could not enable Pages: $post_err"
    echo "    Pages already enabled (by GitHub, for the new $BRANCH branch)" >&2
    set_source
  fi
fi
echo "github-pages: bootstrap done for $REPO (the site is served from $BRANCH)" >&2
