#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=deploy/targets/cloud-run/lib.sh disable=SC1091
source "$(cd "$(dirname "$0")" && pwd)/lib.sh"
# revert <env> <revision>: send 100% of traffic back to <revision>. release.sh
# reverts only to the revision that served before its promote, whose image
# promote kept as "<env>-prev"; an older revision's image may have been
# cleaned up by the registry policy.
init_common
service_for "${1:-}"
rev="${2:-}"
[[ "$rev" =~ ^[a-z0-9-]+$ ]] || usage_error "invalid revision: ${rev:-<empty>}"

run gcloud run services update-traffic "$SERVICE" --project "$GCP_PROJECT_ID" \
  --region "$GCP_REGION" --to-revisions "$rev=100" --quiet

# The restored revision's image is serving again: keep it protected. Traffic
# has already moved, so a tagging failure is reported but doesn't fail revert.
# Traffic has moved: nothing below may fail the revert.
image="$(revision_image "$rev")" || image=""
if ours "$image"; then
  tag_deployed "$image" || echo "cloud-run: could not tag $image as $ENV_NAME" >&2
else
  echo "cloud-run: $rev runs ${image:-<unknown>}, not from ${IMAGE_BASE}; not tagged" >&2
fi
