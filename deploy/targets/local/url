#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=deploy/targets/local/lib.sh disable=SC1091
source "$(cd "$(dirname "$0")" && pwd)/lib.sh"
# url <env>: print the live URL (the serving container's port).
env_vars "${1:-}"

rev="$(live)"
[[ -n "$rev" ]] || die "nothing serves $ENV_NAME"
port="$(port_of "$rev")"
[[ -n "$port" ]] || die "no port recorded for $rev"
printf 'http://127.0.0.1:%s\n' "$port"
